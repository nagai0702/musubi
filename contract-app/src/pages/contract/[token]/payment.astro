---
import { getByToken } from '@/lib/contracts';
const { token } = Astro.params;
const found = token ? await getByToken(token) : null;
const contract = found?.contract;
const canPay = contract?.status === 'signed';
const TELECOM_CREDIT_URL = import.meta.env.TELECOM_CREDIT_URL || '#';
const LIFTI_SCHEDULE_URL = import.meta.env.LIFTI_SCHEDULE_URL || '#';
const BANK_NAME = import.meta.env.BANK_NAME || '（銀行名を設定してください）';
const BANK_BRANCH = import.meta.env.BANK_BRANCH || '（支店名）';
const BANK_TYPE = import.meta.env.BANK_TYPE || '普通';
const BANK_NUMBER = import.meta.env.BANK_NUMBER || '（口座番号）';
const BANK_HOLDER = import.meta.env.BANK_HOLDER || '（口座名義）';
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>お支払い - 結び</title>
  <link rel="stylesheet" href="/contract.css">
</head>
<body>

  <div class="c-header">
    <div class="c-header__inner">
      <div>
        <div class="c-header__brand">株式会社結び</div>
        <div class="c-header__sub">お支払い手続き</div>
      </div>
    </div>
  </div>

  <div class="c-steps">
    <div class="c-steps__inner">
      <div class="c-step done"><span class="c-step__num">&#10003;</span><span class="c-step__label">入力</span></div>
      <div class="c-step done"><span class="c-step__num">&#10003;</span><span class="c-step__label">確認・押印</span></div>
      <div class="c-step active"><span class="c-step__num">3</span><span class="c-step__label">決済</span></div>
      <div class="c-step"><span class="c-step__num">4</span><span class="c-step__label">完了</span></div>
    </div>
  </div>

  {!contract ? (
    <div class="c-container"><div class="c-done"><div class="c-done__icon">!</div><div class="c-done__title">無効なリンク</div></div></div>
  ) : !canPay ? (
    <div class="c-container"><div class="c-done"><div class="c-done__icon">!</div><div class="c-done__title">この画面は表示できません</div><p class="c-done__text">署名が完了していないか、既に決済済みです。</p></div></div>
  ) : contract.paymentMethod === 'transfer' ? (
    <div class="c-container">
      <div class="c-card c-text-center">
        <div style="font-size: 40px; margin-bottom: 12px;">🏦</div>
        <div class="c-card__title" style="justify-content: center;">お振込でのお支払い</div>
        <div class="c-price">&yen;{Number(contract.price.replace(/[^0-9]/g, '') || '0').toLocaleString()}<small>（税込）</small></div>
        <div class="c-bank">
          <div class="c-bank__row"><span class="c-bank__label">銀行名</span><span class="c-bank__value">{BANK_NAME}</span></div>
          <div class="c-bank__row"><span class="c-bank__label">支店名</span><span class="c-bank__value">{BANK_BRANCH}</span></div>
          <div class="c-bank__row"><span class="c-bank__label">口座種別</span><span class="c-bank__value">{BANK_TYPE}</span></div>
          <div class="c-bank__row"><span class="c-bank__label">口座番号</span><span class="c-bank__value">{BANK_NUMBER}</span></div>
          <div class="c-bank__row"><span class="c-bank__label">口座名義</span><span class="c-bank__value">{BANK_HOLDER}</span></div>
        </div>
        <p class="c-note c-text-center">
          上記口座へお振込ください。振込手数料はお客様のご負担となります。<br>
          お振込名義はご契約者名「{contract.name}」でお願いいたします。
        </p>
      </div>
      <a href={`/contract/${token}/complete`} class="c-btn c-btn--primary">確認しました</a>
    </div>
  ) : contract.paymentMethod === 'credit' ? (
    <div class="c-container">
      <div class="c-card c-text-center">
        <div style="font-size: 40px; margin-bottom: 12px;">💳</div>
        <div class="c-card__title" style="justify-content: center;">クレジットカード決済</div>
        <div class="c-price">&yen;{Number(contract.price.replace(/[^0-9]/g, '') || '0').toLocaleString()}<small>（税込）</small></div>
        <p class="c-note c-text-center c-mb-16">「決済画面へ進む」を押すと、テレコムクレジットの決済画面に移動します。</p>
        <a href={TELECOM_CREDIT_URL} class="c-btn c-btn--primary c-mb-16" target="_blank" rel="noopener">決済画面へ進む</a>
      </div>
      <a href={`/contract/${token}/complete`} class="c-btn c-btn--green c-mt-16">決済完了後はこちら</a>
    </div>
  ) : (
    <div class="c-container">
      <div class="c-card c-text-center">
        <div style="font-size: 40px; margin-bottom: 12px;">📅</div>
        <div class="c-card__title" style="justify-content: center;">ライフティ お手続きのご案内</div>
        <div class="c-price">&yen;{Number(contract.price.replace(/[^0-9]/g, '') || '0').toLocaleString()}<small>（税込）</small></div>
        <p class="c-note c-text-center c-mb-16">ライフティのお手続きは別日に行います。<br>下記より日程をご予約ください。</p>
        <a href={LIFTI_SCHEDULE_URL} class="c-btn c-btn--primary c-mb-16" target="_blank" rel="noopener">日程を予約する</a>
      </div>
      <a href={`/contract/${token}/complete`} class="c-btn c-btn--green c-mt-16">確認しました</a>
    </div>
  )}

<script is:inline>
(function() {
  var t = new URL(location.href).pathname.split('/')[2];
  if (t) {
    fetch('/api/contract/activity', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({token:t, page:'payment', detail:'決済画面を閲覧中'}) }).catch(function(){});
    setInterval(function(){ fetch('/api/contract/activity', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({token:t, page:'payment', detail:'決済画面を閲覧中'}) }).catch(function(){}); }, 5000);
  }
})();
</script>
</body>
</html>
